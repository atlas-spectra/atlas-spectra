{
  "schema_version": "0.1.0",
  "id": "wearable.ppg.resting-adult-pulse",
  "name": "Resting adult PPG pulse observations",
  "summary": "Photoplethysmography observes cardiac-synchronous peripheral blood-volume changes optically. This record represents the resulting pulse observations with a population-level resting-adult event-rate range, not a beat-to-beat frequency track.",
  "domains": [
    "wearables",
    "cardiology",
    "optics",
    "biomedical-sensing"
  ],
  "system": {
    "id": "system.ppg.peripheral-optical-sensor",
    "name": "Peripheral photoplethysmography sensor and tissue bed",
    "type": "optical-biomedical-sensor"
  },
  "observable": {
    "id": "observable.ppg.pulse-event-count",
    "name": "Cardiac-synchronous PPG pulse-event count",
    "quantity_kind": "event-count",
    "independent_coordinate": "time"
  },
  "frequency_profile": {
    "type": "event_rate",
    "axis": {
      "kind": "event_rate"
    },
    "rate": {
      "lower": 60,
      "upper": 100,
      "unit": "bpm",
      "quantity_kind": "ppg-pulse-rate"
    },
    "aggregation_window": {
      "value": 60,
      "unit": "s",
      "quantity_kind": "time"
    }
  },
  "conditions": [
    {
      "id": "condition.ppg.resting",
      "property": "activity-state",
      "operator": "equals",
      "value": "resting"
    },
    {
      "id": "condition.ppg.adult",
      "property": "population",
      "operator": "equals",
      "value": "adult"
    }
  ],
  "mechanisms": [
    {
      "id": "mechanism.ppg.optical-blood-volume-transduction",
      "type": "optical-plethysmography",
      "status": "established",
      "description": "A light source illuminates perfused tissue and a photodetector measures transmitted or reflected light; cardiac-synchronous blood-volume changes modulate the detected optical signal."
    }
  ],
  "detectors": [
    {
      "id": "detector.ppg.photodetector",
      "name": "PPG photodetector",
      "type": "photodetector",
      "observes": [
        {
          "id": "observable.ppg.pulse-event-count"
        }
      ]
    }
  ],
