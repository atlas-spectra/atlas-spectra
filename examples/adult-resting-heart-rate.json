      "target_ref": {
        "id": "timekeeping.quartz-wristwatch.one-second-tick",
        "scope": "atlas",
        "label": "Quartz wristwatch one-second tick"
      },
      "description": "The lower endpoint of the 60–100 bpm resting-adult reference range converts to 1 event/s, numerically matching the 1 Hz quartz clock output. This is explicitly a numerical coincidence, not evidence of coupling, resonance, entrainment, or a shared mechanism.",
      "evidence": {
        "basis": "computed_derivation",
        "review_status": "reviewed",
        "source_refs": [
          {
            "id": "source.aha.resting-heart-rate"
          },
          {
            "id": "source.nist.quartz-one-hz-comparison"
          }
        ],
        "derivation": "60 beats/minute × (1 minute / 60 seconds) = 1 event/second; compare that numerical magnitude with the quartz divider's 1 Hz output.",
        "mechanism_status": "none"
      }
    }
