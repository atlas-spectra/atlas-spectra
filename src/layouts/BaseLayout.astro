---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Atlas Spectra",
  description = "Understand frequency across scales.",
} = Astro.props;
const pageTitle = title === "Atlas Spectra" ? title : `${title} · Atlas Spectra`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>Atlas Spectra</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/explore/">Explore</a>
        <a href="https://github.com/atlas-spectra/atlas-spectra">GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
