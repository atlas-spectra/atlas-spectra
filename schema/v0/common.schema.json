{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-spectra.org/schema/v0/common.schema.json",
  "title": "Atlas Spectra v0 common definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "semanticRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "scheme": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "uncertainty": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "absolute"
            },
            "value": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "minus",
            "plus"
          ],
          "properties": {
            "type": {
              "const": "asymmetric"
            },
            "minus": {
              "type": "number",
              "minimum": 0
            },
            "plus": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "relative"
            },
            "value": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "unknown"
            }
          }
        }
      ]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "unit_uri": {
          "type": "string",
          "format": "uri"
        },
        "quantity_kind": {
          "type": "string"
        },
        "quantity_kind_uri": {
          "type": "string",
          "format": "uri"
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        }
      }
    },
    "quantityRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper",
        "unit"
      ],
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "unit_uri": {
          "type": "string",
          "format": "uri"
        },
        "quantity_kind": {
          "type": "string"
        },
        "quantity_kind_uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "temporal_frequency",
            "angular_frequency",
            "spatial_frequency",
            "wavenumber",
            "event_rate",
            "other"
          ]
        },
        "quantity_kind_uri": {
          "type": "string",
          "format": "uri"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string"
        },
        "semantic_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticRef"
          }
        }
      }
    },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "quantity_kind",
        "independent_coordinate"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "quantity_kind": {
          "type": "string",
          "minLength": 1
        },
        "quantity_kind_uri": {
          "type": "string",
          "format": "uri"
        },
        "independent_coordinate": {
          "enum": [
            "time",
            "space",
            "energy",
            "other"
          ]
        },
        "description": {
          "type": "string"
        },
        "semantic_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticRef"
          }
        }
      }
    },
    "conditionScalar": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/quantity"
        }
      ]
    },
    "conditionComparable": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/quantity"
        }
      ]
    },
    "conditionCollection": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/conditionScalar"
      }
    },
    "conditionValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/conditionScalar"
        },
        {
          "$ref": "#/$defs/quantityRange"
        },
        {
          "$ref": "#/$defs/conditionCollection"
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "property",
        "operator",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "equals",
            "not_equals",
            "less_than",
            "less_than_or_equal",
            "greater_than",
            "greater_than_or_equal",
            "between",
            "in",
            "describes"
          ]
        },
        "value": {
          "$ref": "#/$defs/conditionValue"
        },
        "semantic_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticRef"
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "operator": {
                  "enum": [
                    "equals",
                    "not_equals"
                  ]
                },
                "value": {
                  "$ref": "#/$defs/conditionScalar"
                }
              }
            },
            {
              "properties": {
                "operator": {
                  "enum": [
                    "less_than",
                    "less_than_or_equal",
                    "greater_than",
                    "greater_than_or_equal"
                  ]
                },
                "value": {
                  "$ref": "#/$defs/conditionComparable"
                }
              }
            },
            {
              "properties": {
                "operator": {
                  "const": "between"
                },
                "value": {
                  "$ref": "#/$defs/quantityRange"
                }
              }
            },
            {
              "properties": {
                "operator": {
                  "const": "in"
                },
                "value": {
                  "$ref": "#/$defs/conditionCollection"
                }
              }
            },
            {
              "properties": {
                "operator": {
                  "const": "describes"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          ]
        }
      ]
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "status",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "status": {
          "enum": [
            "established",
            "proposed",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "semantic_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticRef"
          }
        }
      }
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "observes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "semantic_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticRef"
          }
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "input_ref",
        "output_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "transduction",
            "filtering",
            "mixing",
            "modulation",
            "frequency_division",
            "frequency_multiplication",
            "encoding",
            "other"
          ]
        },
        "input_ref": {
          "$ref": "#/$defs/reference"
        },
        "output_ref": {
          "$ref": "#/$defs/reference"
        },
        "description": {
          "type": "string"
        },
        "ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rate": {
          "$ref": "#/$defs/quantity"
        },
        "duration": {
          "$ref": "#/$defs/quantity"
        },
        "window": {
          "type": "string"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "observable_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "observable_ref": {
          "$ref": "#/$defs/reference"
        },
        "detector_ref": {
          "$ref": "#/$defs/reference"
        },
        "condition_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "sampling": {
          "$ref": "#/$defs/sampling"
        },
        "semantic_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticRef"
          }
        }
      }
    }
  }
}
