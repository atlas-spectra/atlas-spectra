{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-spectra.github.io/atlas-spectra/data/numerical-neighbor-report.schema.json",
  "title": "Atlas Spectra numerical neighbor computation report v0.1",
  "description": "An unreviewed numerical computation, not a recorded scientific relationship. Semantic arithmetic and count consistency require the accompanying model validator/tests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "method", "interpretation", "reviewStatus", "status", "anchorId", "includeReferences", "anchor", "reason", "counts", "matches", "exclusions"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "method": { "const": "documented-coordinate-intersection-v1" },
    "interpretation": { "const": "numerical-only" },
    "reviewStatus": { "const": "unreviewed-computation" },
    "status": { "enum": ["complete", "anchor-required", "anchor-excluded", "catalog-limit", "invalid-catalog"] },
    "anchorId": { "type": ["string", "null"], "minLength": 1 },
    "includeReferences": { "type": "boolean" },
    "anchor": { "anyOf": [{ "$ref": "#/$defs/input" }, { "type": "null" }] },
    "reason": { "type": ["string", "null"], "minLength": 1 },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogRecords", "comparedPeers", "excludedPeers", "matches"],
      "properties": { "catalogRecords": { "$ref": "#/$defs/count" }, "comparedPeers": { "$ref": "#/$defs/count" }, "excludedPeers": { "$ref": "#/$defs/count" }, "matches": { "$ref": "#/$defs/count" } }
    },
    "matches": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/match" } },
    "exclusions": { "type": "array", "maxItems": 2000, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "reason"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } }
    } }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "complete" } } },
    "then": { "properties": { "anchor": { "$ref": "#/$defs/eligibleInput" }, "anchorId": { "type": "string", "minLength": 1 }, "reason": { "type": "null" } } },
    "else": { "properties": { "reason": { "type": "string", "minLength": 1 }, "matches": { "maxItems": 0 }, "exclusions": { "maxItems": 0 } } }
  }],
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1.7976931348623157e308 } },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "profileType", "axisKind", "coordinateMode", "nativeLabel", "coordinateNote", "quantityTargets", "segmentsHz", "status", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 },
        "profileType": { "type": "string", "minLength": 1 }, "axisKind": { "type": "string", "minLength": 1 },
        "coordinateMode": { "enum": ["native", "normalized", "transformed", "claim-reference", null] },
        "nativeLabel": { "type": "string", "minLength": 1 }, "coordinateNote": { "type": "string", "minLength": 1 },
        "quantityTargets": { "type": "array", "maxItems": 128, "items": { "type": "string", "pattern": "^/(frequency_profile/[^\\s]+|claims/[0-9]+/object)$" } },
        "segmentsHz": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/range" } },
        "status": { "enum": ["eligible", "unpositioned", "unsupported"] }, "reason": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "eligible" } } },
        "then": { "properties": { "segmentsHz": { "minItems": 1 }, "quantityTargets": { "minItems": 1 }, "reason": { "type": "null" }, "coordinateMode": { "type": "string" } } },
        "else": { "properties": { "segmentsHz": { "maxItems": 0 }, "reason": { "type": "string", "minLength": 1 } } }
      }]
    },
    "eligibleInput": { "allOf": [{ "$ref": "#/$defs/input" }, { "properties": { "status": { "const": "eligible" } } }] },
    "match": {
      "type": "object", "additionalProperties": false, "required": ["peer", "kind", "intersections"],
      "properties": {
        "peer": { "$ref": "#/$defs/eligibleInput" },
        "kind": { "enum": ["same-extent", "boundary-only", "shared-points", "overlapping-extents"] },
        "intersections": { "type": "array", "minItems": 1, "maxItems": 256, "items": {
          "type": "object", "additionalProperties": false, "required": ["anchorHz", "peerHz", "sharedHz"],
          "properties": { "anchorHz": { "$ref": "#/$defs/range" }, "peerHz": { "$ref": "#/$defs/range" }, "sharedHz": { "$ref": "#/$defs/range" } }
        } }
      }
    }
  }
}
